# DIEM-A Challenge — environment template
# Copy to `.env` and fill in values. `.env` is gitignored (see .gitignore:42).
# (docs/rule_and_ethics_checklist.md §2) gates secret usage.

# --- External API (motion-to-text rationale) -----------------
# Required for tools/generate_part_rationales_gemini.py
# Obtain from https://aistudio.google.com/ (Google AI Studio).
# Never commit this key. Rotate if accidentally committed.
GEMINI_API_KEY=

# HMAC salt for anonymizing filename in rationale_index.parquet.
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# DO NOT share this salt publicly — paper reports deterministic-index property only.
RATIONALE_HMAC_SALT=

# --- Optional overrides --------------------------------------------------
# Default: data/diema_challenge (defined in utils/env.py)
# DIEMA_DATA_ROOT=

# aitviewer headless rendering. Required on servers without display.
# EGL_PLATFORM=surfaceless
